# =============================================================================
# Hacking Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# Default LLM Provider (used by all agents unless overridden)
# ---------------------------------------------------------------------------

# Provider presets supported by providers.py:
#   deepseek | openai | gpt | anthropic | claude | qwen | dashscope | local | ollama
# Use openai-compatible when you want a custom gateway/base URL.

# Option 1: DeepSeek Direct API
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_KEY_HERE

# Option 2: OpenAI / GPT
# LLM_DEFAULT_PROVIDER=openai
# LLM_DEFAULT_MODEL=gpt-YOUR_MODEL_HERE
# OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE

# Option 3: Anthropic Claude
# LLM_DEFAULT_PROVIDER=anthropic
# LLM_DEFAULT_MODEL=claude-YOUR_MODEL_HERE
# ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Option 4: Qwen / DashScope
# LLM_DEFAULT_PROVIDER=qwen
# LLM_DEFAULT_MODEL=qwen-plus
# QWEN_API_KEY=sk-YOUR_QWEN_OR_DASHSCOPE_KEY_HERE

# Option 5: NVIDIA or any OpenAI-compatible gateway
# LLM_DEFAULT_PROVIDER=openai-compatible
# LLM_DEFAULT_MODEL=deepseek-ai/deepseek-v4-pro
# LLM_DEFAULT_API_KEY=nvapi-YOUR_NVIDIA_API_KEY_HERE
# LLM_DEFAULT_BASE_URL=https://integrate.api.nvidia.com/v1

# Reasoning controls. Unsupported providers are auto-downgraded at runtime.
# LLM_DEFAULT_REASONING_EFFORT=high
# LLM_DEFAULT_THINKING=false
# LLM_DEFAULT_THINKING_BUDGET=8000
# LLM_DEFAULT_ENABLE_THINKING_PARAM=false

# ---------------------------------------------------------------------------
# Per-Agent Overrides (any subset — falls back to DEFAULT)
# ---------------------------------------------------------------------------
# Example: run coordinator on Claude, rest on DeepSeek

# LLM_COORDINATOR_PROVIDER=anthropic
# LLM_COORDINATOR_MODEL=claude-YOUR_MODEL_HERE
# LLM_COORDINATOR_API_KEY=sk-ant-YOUR_KEY_HERE
# LLM_COORDINATOR_THINKING=true
# LLM_COORDINATOR_THINKING_BUDGET=8000

# LLM_RECON_PROVIDER=deepseek
# LLM_RECON_MODEL=deepseek-chat
# LLM_RECON_API_KEY=sk-YOUR_KEY

# LLM_EXPLOITATION_PROVIDER=qwen
# LLM_EXPLOITATION_MODEL=qwen-plus
# LLM_EXPLOITATION_API_KEY=sk-YOUR_QWEN_KEY_HERE
# LLM_EXPLOITATION_REASONING_EFFORT=high

# LLM_ANALYST_PROVIDER=openai
# LLM_ANALYST_MODEL=gpt-YOUR_MODEL_HERE
# LLM_ANALYST_REASONING_EFFORT=high

# LLM_REPORTER_PROVIDER=deepseek
# LLM_REPORTER_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Legacy single-agent mode (agent.py uses these)
# ---------------------------------------------------------------------------
API_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# ---------------------------------------------------------------------------
# Agent Settings
# ---------------------------------------------------------------------------
CONTAINER_NAME=reynard-kali
MAX_ITERATIONS=30

# Live browser dashboard. You can also pass --ui on the CLI.
LIVE_UI=false
LIVE_UI_HOST=127.0.0.1
LIVE_UI_PORT=8765

# ---------------------------------------------------------------------------
# External Integrations
# ---------------------------------------------------------------------------
BURP_MCP_URL=http://127.0.0.1:9876

# Optional public web research providers. If unset, the agent falls back to
# DuckDuckGo HTML search for CTF writeups, CVEs, advisories, and docs.
# BRAVE_SEARCH_API_KEY=YOUR_BRAVE_SEARCH_KEY
# SERPAPI_API_KEY=1eabc17565b847ae380f2623ff07e50eaaace5d5ad83c6460f5130c01d08197e

# OOB callbacks for blind XXE/SSRF/CMDi/log4shell-style tests.
# Keep enabled for blind labs. Set false only when OOB is forbidden by scope.
AUTO_INSTALL_INTERACTSH=true
# INTERACTSH_SERVER=oast.pro
# INTERACTSH_TOKEN=

# Caido Local Bridge (preferred for Replay, HTTP history, API testing).
# Requires a local Caido bridge plugin/service that implements docs/caido-local-bridge.md.
CAIDO_LOCAL_BRIDGE_URL=http://127.0.0.1:17650
# CAIDO_LOCAL_BRIDGE_TOKEN=optional-shared-secret

# Caido Cloud API (https://developer.caido.io/reference/cloud/api.html)
# CAIDO_PAT is used for public Cloud API calls. CAIDO_CLOUD_PAT overrides it
# if you want a separate token from instance automation.
CAIDO_PAT=caido_YOUR_PERSONAL_ACCESS_TOKEN
# CAIDO_CLOUD_PAT=caido_YOUR_CLOUD_ONLY_TOKEN
CAIDO_API_BASE_URL=https://api.caido.io

# Optional: only needed for Caido dashboard GraphQL helpers that create/revoke
# PATs before you already have a PAT.
# CAIDO_SESSION=YOUR_CAIDO_SESSION_COOKIE_VALUE

# Optional legacy placeholder. Use CAIDO_LOCAL_BRIDGE_URL for local Replay/history.
# CAIDO_INSTANCE_URL=http://localhost:8080
