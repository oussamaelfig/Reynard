# =============================================================================
# Hacking Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# Default LLM Provider (used by all agents unless overridden)
# ---------------------------------------------------------------------------

# Provider presets supported by providers.py:
#   deepseek | openai | gpt | anthropic | claude | qwen | dashscope | local | ollama
# Use openai-compatible when you want a custom gateway/base URL.

# Option 1: DeepSeek Direct API
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_KEY_HERE

# Option 2: OpenAI / GPT
# LLM_DEFAULT_PROVIDER=openai
# LLM_DEFAULT_MODEL=gpt-YOUR_MODEL_HERE
# OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE

# Option 3: Anthropic Claude
# LLM_DEFAULT_PROVIDER=anthropic
# LLM_DEFAULT_MODEL=claude-YOUR_MODEL_HERE
# ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Option 4: Qwen / DashScope
# LLM_DEFAULT_PROVIDER=qwen
# LLM_DEFAULT_MODEL=qwen-plus
# QWEN_API_KEY=sk-YOUR_QWEN_OR_DASHSCOPE_KEY_HERE

# Option 5: NVIDIA or any OpenAI-compatible gateway
# LLM_DEFAULT_PROVIDER=openai-compatible
# LLM_DEFAULT_MODEL=deepseek-ai/deepseek-v4-pro
# LLM_DEFAULT_API_KEY=nvapi-YOUR_NVIDIA_API_KEY_HERE
# LLM_DEFAULT_BASE_URL=https://integrate.api.nvidia.com/v1

# Reasoning controls. Unsupported providers are auto-downgraded at runtime.
# LLM_DEFAULT_REASONING_EFFORT=high
# LLM_DEFAULT_THINKING=false
# LLM_DEFAULT_THINKING_BUDGET=8000
# LLM_DEFAULT_ENABLE_THINKING_PARAM=false

# Sampling defaults (preserved if unset: temperature=0.0, max_tokens=4096).
# Provider quirks still apply: OpenAI o-series/GPT-5 ignore temperature, and
# Anthropic extended thinking forces temperature=1.0.
# LLM_DEFAULT_TEMPERATURE=0.0
# LLM_DEFAULT_MAX_TOKENS=4096

# Strict JSON mode. Set false for local models that reject response_format.
# LLM_DEFAULT_JSON_MODE=true

# ---------------------------------------------------------------------------
# Per-Agent Overrides (any subset — falls back to DEFAULT)
# ---------------------------------------------------------------------------
# Roles: coordinator | recon | analyst | exploitation | validator | reporter | pivot
# Every role supports the same suffixes:
#   _PROVIDER _MODEL _API_KEY _BASE_URL _JSON_MODE
#   _REASONING_EFFORT _THINKING _THINKING_BUDGET _ENABLE_THINKING_PARAM
#   _TEMPERATURE _MAX_TOKENS
# Example: run coordinator on Claude, rest on DeepSeek

# LLM_COORDINATOR_PROVIDER=anthropic
# LLM_COORDINATOR_MODEL=claude-YOUR_MODEL_HERE
# LLM_COORDINATOR_API_KEY=sk-ant-YOUR_KEY_HERE
# LLM_COORDINATOR_THINKING=true
# LLM_COORDINATOR_THINKING_BUDGET=8000
# LLM_COORDINATOR_TEMPERATURE=0.0
# LLM_COORDINATOR_MAX_TOKENS=4096

# LLM_RECON_PROVIDER=deepseek
# LLM_RECON_MODEL=deepseek-chat
# LLM_RECON_API_KEY=sk-YOUR_KEY
# LLM_RECON_JSON_MODE=true

# LLM_EXPLOITATION_PROVIDER=qwen
# LLM_EXPLOITATION_MODEL=qwen-plus
# LLM_EXPLOITATION_API_KEY=sk-YOUR_QWEN_KEY_HERE
# LLM_EXPLOITATION_REASONING_EFFORT=high
# LLM_EXPLOITATION_MAX_TOKENS=8192

# LLM_ANALYST_PROVIDER=openai
# LLM_ANALYST_MODEL=gpt-YOUR_MODEL_HERE
# LLM_ANALYST_REASONING_EFFORT=high

# The validator re-tests claimed PoCs (skeptical). Defaults to high reasoning.
# LLM_VALIDATOR_PROVIDER=anthropic
# LLM_VALIDATOR_MODEL=claude-YOUR_MODEL_HERE
# LLM_VALIDATOR_REASONING_EFFORT=high

# The pivot role drives escalation only when stuck. Defaults to xhigh reasoning.
# LLM_PIVOT_PROVIDER=anthropic
# LLM_PIVOT_MODEL=claude-YOUR_MODEL_HERE
# LLM_PIVOT_REASONING_EFFORT=xhigh

# LLM_REPORTER_PROVIDER=deepseek
# LLM_REPORTER_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Legacy single-agent mode (agent.py uses these)
# ---------------------------------------------------------------------------
API_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# ---------------------------------------------------------------------------
# Agent Settings
# ---------------------------------------------------------------------------
CONTAINER_NAME=reynard-kali
MAX_ITERATIONS=30

# Max bounded bootstrap subagents to run in parallel (also --max-subagents).
MAX_SUBAGENTS=4

# Live browser dashboard. You can also pass --ui on the CLI.
LIVE_UI=false
LIVE_UI_HOST=127.0.0.1
LIVE_UI_PORT=8765

# ---------------------------------------------------------------------------
# Headless Chromium (Playwright) — browser_* tools run inside the container
# ---------------------------------------------------------------------------
# Max seconds to allow a single browser job (docker exec) to run.
BROWSER_EXEC_TIMEOUT=90
# Optional explicit Chromium binary path inside the container. Leave unset to
# use the browser installed by `playwright install chromium` in the Dockerfile.
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium

# ---------------------------------------------------------------------------
# Token / Cost Metering & Budget Caps
# ---------------------------------------------------------------------------
# Prices used to estimate run cost from metered tokens. Default 0 => cost shown
# as $0 until you fill in your provider's per-1k-token prices.
LLM_INPUT_PRICE_PER_1K=0
LLM_OUTPUT_PRICE_PER_1K=0

# Hard budget caps. When exceeded mid-run the orchestrator stops dispatching new
# specialists and forces a final report. 0 (or unset) disables the cap.
LLM_MAX_TOKENS_BUDGET=0
LLM_MAX_COST_BUDGET=0

# ---------------------------------------------------------------------------
# Context Management & Prompt Caching (cost efficiency for cheap/local models)
# ---------------------------------------------------------------------------
# LLM-free, deterministic context shaping (core/context.py). All default-on
# except the opt-in few-shot library.

# Signal-preserving observation compaction. Replaces naive raw[:6000] truncation
# with a digest that keeps status/headers/errors/reflection/solved banners/forms.
# Set 0 to fall back to plain truncation.
REYNARD_CONTEXT_COMPACTION=1
# Max chars kept per compacted observation (also the truncation budget when
# compaction is disabled).
REYNARD_CONTEXT_MAX_CHARS=6000
# KG-diff incremental context injection: after the first turn, send a compact
# stable summary + only what changed instead of the full KG snapshot. Set 0 to
# always send the full snapshot.
REYNARD_CONTEXT_KG_DIFF=1
# Opt-in few-shot exploit transcripts for hard vuln classes (sqli/xss/ssrf/idor/
# ssti/xxe). Token-light; default OFF.
REYNARD_FEWSHOT_EXPLOITS=0

# Provider prompt caching. Adds Anthropic cache_control breakpoints on the stable
# system+tools prefix (auto-disabled at runtime if the API rejects it). DeepSeek
# and other OpenAI-compatible gateways cache automatically on the stable prefix.
# Set 0 to disable the explicit Anthropic breakpoints.
REYNARD_PROMPT_CACHE=1

# ---------------------------------------------------------------------------
# Live Solve-Rate Eval Harness (reynard-lab-eval --live)
# ---------------------------------------------------------------------------
# Per-lab wall-clock timeout in seconds (0 = no timeout). CLI: --per-lab-timeout
EVAL_PER_LAB_TIMEOUT=900
# Stop launching new labs after this total wall-clock budget (0 = unlimited).
EVAL_MAX_TOTAL_SECONDS=0
# Credential placeholders referenced by eval/labs.sample.yaml (never hardcode).
# PORTSWIGGER_USERNAME=wiener
# PORTSWIGGER_PASSWORD=peter

# ---------------------------------------------------------------------------
# External Integrations
# ---------------------------------------------------------------------------
BURP_MCP_URL=http://127.0.0.1:9876

# Optional public web research providers. If unset, the agent falls back to
# DuckDuckGo HTML search for CTF writeups, CVEs, advisories, and docs.
# BRAVE_SEARCH_API_KEY=your_brave_search_key_here
# SERPAPI_API_KEY=your_serpapi_key_here

# ---------------------------------------------------------------------------
# OSINT / external recon (prod assessments only — NOT needed for isolated labs)
# ---------------------------------------------------------------------------
# Shodan powers shodan_host_lookup / shodan_search. Without a key those tools
# degrade gracefully with a clear message (they never crash the run).
# SHODAN_API_KEY=your_shodan_api_key_here
# SHODAN_BASE_URL=https://api.shodan.io

# Censys (optional alternative) powers censys_host. Needs BOTH id and secret.
# CENSYS_API_ID=your_censys_api_id_here
# CENSYS_API_SECRET=your_censys_api_secret_here
# CENSYS_BASE_URL=https://search.censys.io

# OOB callbacks for blind XXE/SSRF/CMDi/log4shell-style tests.
# Keep enabled for blind labs. Set false only when OOB is forbidden by scope.
AUTO_INSTALL_INTERACTSH=true
# INTERACTSH_SERVER=oast.pro
# INTERACTSH_TOKEN=

# Caido Local Bridge (preferred for Replay, HTTP history, API testing).
# Requires a local Caido bridge plugin/service that implements docs/caido-local-bridge.md.
CAIDO_LOCAL_BRIDGE_URL=http://127.0.0.1:17650
# CAIDO_LOCAL_BRIDGE_TOKEN=optional-shared-secret

# Caido Cloud API (https://developer.caido.io/reference/cloud/api.html)
# CAIDO_PAT is used for public Cloud API calls. CAIDO_CLOUD_PAT overrides it
# if you want a separate token from instance automation.
CAIDO_PAT=caido_YOUR_PERSONAL_ACCESS_TOKEN
# CAIDO_CLOUD_PAT=caido_YOUR_CLOUD_ONLY_TOKEN
CAIDO_API_BASE_URL=https://api.caido.io

# Optional: only needed for Caido dashboard GraphQL helpers that create/revoke
# PATs before you already have a PAT.
# CAIDO_SESSION=YOUR_CAIDO_SESSION_COOKIE_VALUE

# Optional legacy placeholder. Use CAIDO_LOCAL_BRIDGE_URL for local Replay/history.
# CAIDO_INSTANCE_URL=http://localhost:8080

# =============================================================================
# Cross-domain (WS5): network/pwn + mobile + CTF misc
# =============================================================================
# Flag pattern used by the flag_hunter tool (and by radare2/stego/forensics/
# hash_crack output scanning). Override for a challenge-specific flag format,
# e.g. REYNARD_FLAG_REGEX="MYCTF\{[^}]+\}". Default matches common CTF forms
# (flag/ctf/key/htb/pico/thm){...}.
# REYNARD_FLAG_REGEX=(?:flag|ctf|key|htb|pico|thm)\{[^}]{1,120}\}

# =============================================================================
# Orchestration strategy (WS2): hypothesis agenda, phase chaining, pivot
# =============================================================================
# The multi-agent orchestrator now drives a first-class hypothesis agenda
# through the 6-phase StrategyEngine (RECON -> INJECTION -> CONTEXT ->
# CAPABILITY -> ESCAPE -> EXPLOIT). Repeated failure of a vector demotes it and
# the run backtracks to the next hottest hypothesis; when stuck, the high-
# reasoning `pivot` role escalates once before returning to normal routing.

# Gate premature final reports: while untried actionable hypotheses remain and
# nothing is verified yet, the orchestrator forces progress instead of
# reporting. Set to 0/false to restore the old "report when budget<25%" path.
# REYNARD_REPORT_GATING=1
# Max number of times a premature report may be gated per run (safety cap).
# REYNARD_MAX_REPORT_GATES=6

# Adaptive inner-loop tool budget for recon/exploitation. 0 = use per-agent
# defaults (recon=10, exploitation=12) plus automatic bumps for expert/auth-
# heavy playbooks. Set a positive integer to request a higher floor.
# REYNARD_INNER_BUDGET=0

# The `pivot` role (high-reasoning escalation + self-critique) reuses the
# standard per-role LLM_* overrides. It defaults to reasoning_effort=xhigh.
# LLM_PIVOT_PROVIDER=
# LLM_PIVOT_MODEL=
# LLM_PIVOT_API_KEY=
# LLM_PIVOT_REASONING_EFFORT=xhigh

# ---------------------------------------------------------------------------
# Tiered model escalation (strong-reasoning tier)
# ---------------------------------------------------------------------------
# The `strong` tier is the auto-escalation model: the cheap default runs
# normally, and the coordinator + exploitation dispatch swap to `strong` when
# the run stalls/backtracks, on EXPERT-tier labs, or when forced. Each field
# falls back LLM_STRONG_* -> LLM_PIVOT_* -> default, so one strong model can be
# declared once and reused for both stuck-pivots and tier escalation.
# LLM_STRONG_PROVIDER=anthropic
# LLM_STRONG_MODEL=claude-YOUR_MODEL_HERE
# LLM_STRONG_API_KEY=
# LLM_STRONG_BASE_URL=
# LLM_STRONG_REASONING_EFFORT=xhigh

# Master switch for tier escalation (swap to strong when stuck). Default on.
# REYNARD_TIER_ESCALATION=1
# Escalate to the strong tier from the first step on EXPERT-tier labs (the
# lab_level comes from the corpus / eval config). Default on.
# REYNARD_ESCALATE_ON_EXPERT=1
# Force the strong tier for the entire run (used by the training-loop re-run
# pass over previously-unsolved labs). Default off.
# REYNARD_FORCE_STRONG_TIER=0

# ---------------------------------------------------------------------------
# Batch training/eval loop (reynard-lab-eval --train)
# ---------------------------------------------------------------------------
# Auto-re-run each unsolved lab ONCE at the escalated (strong) tier. Default on.
# REYNARD_TRAIN_RERUN_STRONG=1
# Refresh docs/portswigger-coverage-matrix.md at the end of a training run.
# Default on.
# REYNARD_TRAIN_REFRESH_MATRIX=1

# ---------------------------------------------------------------------------
# Authorized client assessment (reynard-assess)
# ---------------------------------------------------------------------------
# reynard-assess runs a scoped recon -> enumerate -> test -> report flow bound
# by an engagement config (see eval/engagement.sample.yaml). The engagement
# file defines the authorized scope + rules of engagement (out-of-scope
# denylist, max_requests_per_second, max_total_requests, allow_destructive,
# testing_window). The command REFUSES to run without an authorized scope.
#
#   reynard-assess --engagement eval/engagement.sample.yaml [--out DIR]
#
# Per-target wall-clock timeout in seconds (0 = no timeout). CLI: --per-target-timeout
ASSESS_PER_TARGET_TIMEOUT=1800
